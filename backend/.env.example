# 数据库连接
DATABASE_URL=postgresql://clawhub:clawhub@localhost:5432/clawhub

# API 基础 URL（Swagger 文档用）
API_BASE=http://localhost:3001

# JWT 密钥（用于 token 签名，至少 32 字符）
JWT_SECRET=your-jwt-secret-key-min-32-chars

# 文件存储目录
STORAGE_DIR=./storage

# Authing 配置（用于用户认证）
AUTHING_APP_ID=your_app_id
AUTHING_APP_SECRET=your_app_secret
AUTHING_DOMAIN=your-domain.authing.cn
AUTHING_REDIRECT_URI=http://localhost:3000/auth/callback
AUTHING_USER_POOL_ID=your_user_pool_id

# CLI Token 验证模式
# true: 内网模式，跳过 token 验证，接受任意请求
# false: 验证 token (默认)
CLI_ALLOW_ANY_TOKEN=false
